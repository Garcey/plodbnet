rust_engine/bench/Cargo.lock
rust_engine/bench/Cargo.lock.root
dist/
build/
*.egg-info/
*.pyd
*.pdb
*.so

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Training outputs (huge; pull via scp instead)
checkpoints/
*.pt
logs/
runs/

# Local OCR captures and debug artifacts
screenrecords/
recordings/
tmp/
tmp_sweep/
_*.png
_*.log
_diag_*/
debug_*.png
ui.log

# Claude Code workspace state (plans/memory live elsewhere)
.claude/

# Backup files
*.bak
*.bak.*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets and user data (never commit). The deploy additionally content-scans
# what it ships, and gitleaks (.gitleaks.toml) scans commits.
.env
.env.*
!.env.example
!*.example
client_secret*
*.key
*.p12
*.pfx
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
data/

# SSH keys / known_hosts for the training pod + VPS (never commit — a broad
# `git add -A` sync commit would otherwise push the private key to GitHub).
ssh/
*.pem
id_ed25519*
id_rsa*

# Tools and other assistants' scratch space
node_modules/
.grok/
.ruff_cache/
.mypy_cache/
