# Editor settings for this repo (https://editorconfig.org). Line endings are
# managed by .gitattributes; this keeps editors from adding byte-order marks and
# from breaking the files that must be LF (bash) or CRLF (Windows scripts).
root = true

[*]
charset = utf-8
insert_final_newline = true

[*.{py,rs,sh}]
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json}]
indent_style = space
indent_size = 2

[{*.sh,ops/bin/*,scripts/hooks/*}]
end_of_line = lf
indent_size = 2

[*.{bat,ps1}]
end_of_line = crlf
