# /etc/wrapgto/backup.env — the off-site copy and the backup monitor (read by
# /usr/local/sbin/wrapgto-backup). root-only:  chmod 600 /etc/wrapgto/backup.env
# Set up once: ops/SERVER_SETUP.md, "Backups".

# restic repository at ANOTHER provider than the server (so losing the server AND the
# Hetzner account together still leaves a copy). Backblaze B2:
RESTIC_REPOSITORY=b2:<bucket-name>:wrapgto
B2_ACCOUNT_ID=<keyID of an application key limited to that bucket>
B2_ACCOUNT_KEY=<applicationKey>
# …or a Hetzner Storage Box / any sftp server:
# RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:wrapgto
# The encryption password — keep a copy OFF the server (a password manager): without
# it the off-site copy cannot be read by anyone, including you.
RESTIC_PASSWORD_FILE=/etc/wrapgto/restic-password

# healthchecks.io (or any URL that alerts when pings stop): one check for the nightly
# backup (period 1 day, grace 2 h) and one for the monthly restore drill.
HC_PING_URL=https://hc-ping.com/<uuid-of-the-backup-check>
HC_DRILL_URL=https://hc-ping.com/<uuid-of-the-drill-check>

# Optional:
# WRAPGTO_BACKUP_DAYS=14          local snapshots kept
