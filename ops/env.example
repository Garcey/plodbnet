# /etc/wrapgto/env — the production app's settings (systemd EnvironmentFile).
# Copy to the server, fill in the secrets, then:  chown root:root /etc/wrapgto/env &&
# chmod 600 /etc/wrapgto/env  (systemd reads it as root; the app never sees the file).
# Format: NAME=value, one per line, no `export`, no spaces around '='.
# Every variable the web app reads is listed here (tests/python/test_ops_files.py
# fails when one is missing). Values shown are the production choices; a line left
# commented keeps the default in brackets.

# --- the public build --------------------------------------------------------------
PLO5BP_PUBLIC=1
PLO5BP_BASE_URL=https://wrapgto.com
# PLO5BP_DB=                      [<app>/data/public.db] SQLite database
# Admins: an email allowlist; PINNING to Google account ids is safer (an email can change hands).
# (An EMPTY value means "no admins" — leave the line commented to keep the default.)
# PLO5BP_ADMIN_EMAILS=            [the owner's address — public.py] comma-separated
# PLO5BP_ADMIN_SUBS=              [] comma-separated Google account ids ("sub") allowed to be admin
# PLO5BP_FREE_FOR_ALL=1           [1] the whole site free for signed-in users while the models train
# PLO5BP_FREE_HANDS=5             [5] free trainer hands per UTC day (only when FREE_FOR_ALL=0)
# PLO5BP_PRICE_CENTS=1000         [1000] monthly price, used when the Stripe price is first created

# --- sign-in -------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PLO5BP_EMAIL_LOGIN=             [off] email sign-in links (needs the SMTP settings below)
# PLO5BP_SMTP_HOST=
# PLO5BP_SMTP_PORT=587
# PLO5BP_SMTP_USER=
# PLO5BP_SMTP_PASSWORD=
# PLO5BP_SMTP_FROM=
# PLO5BP_SMTP_SSL=0               [0] 1 = implicit TLS (port 465); default STARTTLS
# Cookie-signing key(s), comma-separated, newest first (rotation). Unset: a key kept
# in the database. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
# PLO5BP_SESSION_SECRET=
# PLO5BP_SESSION_COOKIE=session  [session] sign-in cookie name (local previews use one per port)
# NEVER in production — loopback-only fake sign-in for local testing:
# PLO5BP_DEV_LOGIN=
# PLO5BP_DEV_LOGIN_TESTCLIENT=

# --- Stripe (only needed once the paywall is back: FREE_FOR_ALL=0) ------------------------
# STRIPE_SECRET_KEY=              sk_live_… in production only (the app refuses a live key
#                                 next to the dev login or a loopback base URL)
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=                [created on the first checkout]
# PLO5BP_STRIPE_TIMEOUT=8
# PLO5BP_STRIPE_GRACE_DAYS=3
# PLO5BP_STRIPE_RETRY_S=900

# --- the models ------------------------------------------------------------------------
# The checkpoints on the server were trained before the 2026-09-20 observation fix:
# serve them with the semantics they were trained on (the log / /health say OBS-REV
# MISMATCH otherwise). Drop this line only when a checkpoint trained at rev 2 is promoted.
PLO5BP_OBS_REV=1
# PLO5BP_CHECKPOINT=              [checkpoints/stub.pt] the PLO5 model
# PLO5BP_CHECKPOINT_NLH=          [checkpoints/nlh_stub.pt]
# PLO5BP_CHECKPOINT_CANDIDATE=    [] an admin-only candidate to try before promoting
# PLO5BP_CHECKPOINT_EXPERIMENTAL= [] the older name of CANDIDATE
# PLO5BP_GTO_CHECKPOINT=          [] the NLH GTO PolicyNet (NLH only)
# PLO5BP_SERVE_EMA=               [off] 1 = serve the checkpoint's EMA actor
# PLO5BP_TRUST_CHECKPOINTS=       [off in public mode] 1 = full unpickling (only for files you made)
# PLO5BP_DEVICE=cpu               [cpu]
# PLO5BP_TORCH_THREADS=           [the CPU count] torch threads for inference
# PLO5BP_MODEL_SLOTS=             [from the CPU count] concurrent model evaluations
# PLO5BP_MODEL_WAIT_S=30          [30] how long a request waits for a slot

# --- home games ------------------------------------------------------------------------
# PLO5BP_HOMEGAME_FAIR=1          [1] the verifiable shuffle (0 = the old dealing)
# PLO5BP_HOMEGAME_GRADING=1       [1] grade every home-game decision in the background
# PLO5BP_HOMEGAME_MAX_TABLES=5    [5] open tables per host
# PLO5BP_GAMES_RATE=20,200        [20,200] /games/api requests per user: per second, burst (0 = off)
# PLO5BP_HOMEGAME_LOCK_CHECKS=0   [off; on under pytest] debugging: assert the table locks are held

# --- files the app writes: keep them in data/ (the only folder the hardened service
# unit lets it write besides checkpoints/) ------------------------------------------------
PLO5BP_TRAINER_STATS=/opt/wrapgto/app/data/trainer_stats.json

# --- limits and operations --------------------------------------------------------------
# PLO5BP_MAX_RUNTIMES=300         [300] per-user in-memory states kept
# PLO5BP_RUNTIME_IDLE_S=21600     [6 h] an idle user's state is dropped after this
# PLO5BP_ACTIVE_WINDOW=300        [300] seconds a user counts as "active" on the admin page
# PLO5BP_RATE_PER_S=4             [4] requests per second per client (token bucket)
# PLO5BP_RATE_BURST=120           [120]
# PLO5BP_MAX_BODY=65536           [64 KiB] largest request body
# PLO5BP_USER_QUEUE=4             [4] model requests one user may queue
# PLO5BP_USER_INFLIGHT=12         [12]
# PLO5BP_SESSION_LOCK_TIMEOUT_S=20 [20] longest wait for one user's trainer session lock
# PLO5BP_LOG_LEVEL=INFO           [INFO]
# PLO5BP_BUILD_COMMIT=            [BUILD_INFO.json, written by the deploy] overrides /health's build.commit —
#                                 never in production: deploys refuse it (it would hide which code answers)
