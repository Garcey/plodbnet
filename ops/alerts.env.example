# /etc/wrapgto/alerts.env — where wrapgto-watch sends alerts (every 5 minutes it checks
# the app, the tunnel, /health, the disk and the backups). root-only: chmod 600.
# Set up once: ops/SERVER_SETUP.md, "Monitoring".

# A private ntfy topic — install the ntfy app on your phone and subscribe to it. Use a
# long random name (anyone who knows it can read the alerts):
#   python3 -c "import secrets; print('wrapgto-' + secrets.token_urlsafe(18))"
NTFY_URL=https://ntfy.sh/<long-random-topic>
# NTFY_TOKEN=                      only for a protected topic / self-hosted ntfy

# A healthchecks.io check (period 5 min, grace 10 min): alerts when the pings STOP —
# i.e. when the whole server is down, which no script on the server can report.
HC_WATCH_URL=https://hc-ping.com/<uuid-of-the-watch-check>

# Optional:
# WRAPGTO_DISK_MAX_PCT=85          alert above this disk use
